---
interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

const {
  title,
  description = "RCAN Protocol Specification - Robot Communication and Addressing Network",
  ogImage = "/og.svg",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, "https://rcan.dev");
const ogImageURL = new URL(ogImage, "https://rcan.dev");
// Pages that already name RCAN in their title keep it as is; others get the site suffix.
const fullTitle = /\bRCAN\b/.test(title) ? title : `${title} | RCAN Protocol`;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{fullTitle}</title>

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="rcan.dev" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
  </head>
  <body class="bg-bg text-text font-sans antialiased min-h-screen flex flex-col selection:bg-accent selection:text-bg relative">
    <div class="noise-background"></div>
    <SiteHeader />
    <main class="flex-1 w-full max-w-7xl mx-auto px-6 pt-24 pb-12 z-10 relative">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>

<style is:global>
  /* Links inside running text are underlined so they don't rely on colour alone (WCAG 1.4.1). */
  main p a:not([class*="px-"]),
  main li a:not([class*="px-"]):not([class*="block"]),
  main td a,
  main blockquote a {
    text-decoration-line: underline;
    text-underline-offset: 2px;
    text-decoration-thickness: 1px;
  }

  /* Phone widths: long code, tables and identifiers scroll or wrap instead of widening the page. */
  @media (max-width: 640px) {
    main pre { max-width: 100%; overflow-x: auto; }
    main table { display: block; max-width: 100%; overflow-x: auto; }
    main .flex-1, main .grid > * { min-width: 0; }
    main p, main li, main span, main :not(pre) > code { overflow-wrap: anywhere; }
    main td, main th, main td code, main th code, main h1 span, main h2 span { overflow-wrap: normal; }
  }
</style>

<style>
  .noise-background {
    position: fixed;
    inset: 0;
    pointer-events: none;
    opacity: 0.03;
    z-index: 50;
    mix-blend-mode: overlay;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
  }
</style>

